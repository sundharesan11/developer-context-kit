---
// Starlight follows the OS colour scheme by default. The devctx site is a
// "Night" site, so a first-time visitor starts on the dark theme. After that
// first visit Starlight's own theme picker (dark / light / auto) is respected.
import Default from '@astrojs/starlight/components/ThemeProvider.astro';
---

<script is:inline>
	try {
		if (!localStorage.getItem('devctx-theme-seeded')) {
			localStorage.setItem('devctx-theme-seeded', '1');
			if (!localStorage.getItem('starlight-theme')) localStorage.setItem('starlight-theme', 'dark');
		}
	} catch (e) {}
</script>
<Default />
