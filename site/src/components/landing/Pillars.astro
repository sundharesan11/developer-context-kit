---
import { DOCS } from '../../site';

// Kept as strings so the line breaks inside these white-space:pre trees
// survive Astro's HTML whitespace compression.
const kitTree = `<span class="d">devtwin/</span>
├─ bin/devtwin.mjs
├─ skills/
│  ├─ devtwin-resume/
│  ├─ devtwin-record/
│  ├─ devtwin-onboard/
│  ├─ devtwin-capture/
│  └─ devtwin-setup/
├─ templates/skills/
└─ LICENSE  <span class="muted">Apache-2.0</span>`;
const dataTree = `<span class="d">~/.devtwin/</span>  <span class="muted">0700</span>
├─ live.json
├─ kits/  <span class="muted">pinned kit</span>
└─ store/
   ├─ config/  <span class="muted">scopes, profile</span>
   ├─ data/scopes/
   │  ├─ work/
   │  └─ client/
   ├─ data/personal/  <span class="muted">lessons, preferences</span>
   ├─ data/exports/
   └─ state/`;
// Each tree line gets its own span so the trees can print in line by line (motion on only).
const lines = (tree: string) =>
	tree.split('\n').map((l, i) => `<span class="ln" style="--i:${i}">${l}</span>`).join('\n');
---
<section class="section" aria-labelledby="pillars-title" style="padding-bottom:40px">
  <div class="wrap">
    <div class="intro reveal">
      <div class="kicker">What devtwin is</div>
      <h2 class="h2" id="pillars-title" data-words>A second you, <span class="soft">in every session.</span></h2>
      <p>Never teach an agent the same process twice. devtwin carries your taste and lessons into every project and every agent, and keeps each project's decisions with that project.</p>
    </div>

    <!-- Pillar 1 -->
    <article class="pillar" id="context" aria-labelledby="p1">
      <div class="p-copy reveal">
        <div class="p-num"><span>01</span> Project context</div>
        <h3 id="p1">Never brief an agent from scratch again.</h3>
        <p>Agents record decisions, constraints and handoffs as they work. Each one cites its source, and you can undo any of them.</p>
        <ul class="ticks">
          <li><span>Linked to a file, commit, issue or URL.</span></li>
          <li><span><code>activity</code> shows what changed this week. <code>undo</code> reverses it.</span></li>
          <li><span>Claude memory and <code>docs/solutions</code> become records every day.</span></li>
        </ul>
        <a class="p-more" href={DOCS.records}>How records work <span aria-hidden="true">→</span></a>
      </div>
      <div class="frame reveal">
        <div class="frame-in">
          <div class="f-bar"><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="ttl">Activity · work.billing</span><span class="right"><span class="pill acc">3 this week</span></span></div>
          <div class="review">
            <div class="queue" role="list" aria-label="Records learned this week">
              <h4>Learned</h4>
              <span class="q-item on" role="listitem">Cursor pagination for /tasks<small>decision · by agent</small></span>
              <span class="q-item" role="listitem">Integration tests need Docker<small>constraint · by agent</small></span>
              <span class="q-item" role="listitem">Who owns the v1 webhook?<small>unknown · from memory</small></span>
            </div>
            <div class="rec">
              <div class="rec-top"><span class="pill acc">decision</span><span class="pill">observed</span><span class="pill">work.billing</span></div>
              <h4>Use cursor pagination for /tasks</h4>
              <p>Offset paging skipped rows under concurrent inserts. Cursor on <span class="mono" style="font-size:12.5px;color:#c9d0de">(created_at, id)</span>; page size capped at 100.</p>
              <div class="srcs">
                <div class="src-row"><span class="k">file</span><span class="v">src/api/tasks.ts</span><span class="h">sha 3e1f…</span></div>
                <div class="src-row"><span class="k">commit</span><span class="v">9f2c1ab · switch list to cursor</span><span class="h">main</span></div>
                <div class="src-row"><span class="k">issue</span><span class="v">BILL-148 · duplicate tasks on page 2</span><span class="h">open</span></div>
              </div>
              <div class="supers">supersedes <s>rec_7a2f… · “offset paging is fine for v1”</s></div>
              <div class="rec-act">
                <span class="rec-cmd"><span class="acc">$</span> devtwin undo --id aud_4c1e…</span>
                <span class="pill ok">audited · undoable</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </article>

    <!-- Pillar 2 -->
    <article class="pillar flip" id="agents" aria-labelledby="p2">
      <div class="p-copy reveal">
        <div class="p-num"><span>02</span> Many agents</div>
        <h3 id="p2">Run your agents like one team.</h3>
        <p>Start a task in Claude Code and finish it in Codex. Every agent reads the same brief, rules and lessons and picks up the last handoff, so you can split work across agents without repeating yourself.</p>
        <ul class="ticks">
          <li><span><code>handoff write</code> leaves the next step for whichever agent comes next.</span></li>
          <li><span><code>devtwin-resume</code> loads the brief and the handoff in any agent.</span></li>
          <li><span>Note which agent suits which work, for every agent to read.</span></li>
        </ul>
        <a class="p-more" href={DOCS.codingAgents}>Set up your coding agents <span aria-hidden="true">→</span></a>
      </div>
      <div class="frame reveal">
        <div class="frame-in">
          <div class="f-bar"><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="ttl">One task, two agents · work.billing</span><span class="right"><span class="pill ok">same context</span></span></div>
          <div class="f-body" aria-label="A task handed from Claude Code to Codex">
            <div class="brief">
              <div class="brief-h"><span><b>Claude Code</b> <span class="muted">· 10:12</span></span><span class="muted">builds</span></div>
              <div class="bsec">
                <div class="brow"><span class="dot"></span><span>› implement the retry backoff</span><span class="src">you</span></div>
                <div class="brow"><span class="dot"></span><span>Jitter added, tests pass</span><span class="src">3e1f9a2</span></div>
                <div class="brow"><span class="dot c"></span><span>handoff write: 429 handling is next</span><span class="src">handoff</span></div>
              </div>
              <div class="brief-h"><span><b>Codex</b> <span class="muted">· 10:40</span></span><span class="muted">reviews, then continues</span></div>
              <div class="bsec">
                <div class="brow"><span class="dot"></span><span>› devtwin-resume</span><span class="src">brief + handoff</span></div>
                <div class="brow"><span class="dot"></span><span>Retry reuses the idempotency key</span><span class="src">your rule</span></div>
                <div class="brow"><span class="dot"></span><span>Continues 429 handling in src/jobs/retry.ts</span><span class="src">handoff</span></div>
              </div>
              <div class="bsec"><h4>Your preference</h4>
                <div class="brow"><span class="dot q"></span><span>Claude Code builds. Codex reviews.</span><span class="src">personal</span></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </article>

    <!-- Pillar 3 -->
    <article class="pillar" id="lessons" aria-labelledby="p3">
      <div class="p-copy reveal">
        <div class="p-num"><span>03</span> Team lessons</div>
        <h3 id="p3">Learn a lesson once. Your whole team keeps it.</h3>
        <p>A lesson is a do or don't with a reason. When an agent touches matching code, the lesson shows up, including your team's.</p>
        <ul class="ticks">
          <li><span>At most four short lines per session.</span></li>
          <li><span>Lessons for every project wait for your weekly review.</span></li>
          <li><span>Shared lessons wait 24 hours, so you can cancel them.</span></li>
        </ul>
        <a class="p-more" href={DOCS.lessons}>How lessons reach your agents <span aria-hidden="true">→</span></a>
      </div>
      <div class="frame reveal">
        <div class="frame-in">
          <div class="f-bar"><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="ttl">Claude Code · work.billing</span><span class="right"><span class="pill acc">hook live</span></span></div>
          <div class="f-body">
            <div class="agent-line">
              <span class="cmd"><span class="p">›</span> Edit src/billing/client/retry.ts</span>
              <span class="pill">pre-tool</span>
            </div>
            <div class="brief">
              <div class="brief-h"><span><b>devtwin lessons</b> <span class="muted">· data from teammates</span></span><span class="muted">2 of 4 lines</span></div>
              <div class="bsec"><h4>Matched by path</h4>
                <div class="brow"><span class="dot"></span><span>Don't retry 4xx from the billing API</span><span class="src">handle:priya</span></div>
                <div class="brow"><span class="dot"></span><span>Keep retry jitter on; the queue spikes without it</span><span class="src">you</span></div>
              </div>
              <div class="bsec"><h4>Working on</h4>
                <div class="brow"><span class="dot q"></span><span>priya on fix/billing-timeouts touching src/billing</span><span class="src">until Thu</span></div>
              </div>
              <div class="bsec"><h4>Session end</h4>
                <div class="brow"><span class="dot c"></span><span>1 lesson saved for work.billing · undoable</span><span class="src">activity</span></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </article>

    <!-- Pillar 4 -->
    <article class="pillar flip" id="accounts" aria-labelledby="p4">
      <div class="p-copy reveal">
        <div class="p-num"><span>04</span> Accounts</div>
        <h3 id="p4">Never push as the wrong account again.</h3>
        <p>Each org you work for gets its own scope and its own accounts, from GitHub and Slack to your issue tracker and cloud. The project decides which account the agent uses.</p>
        <ul class="ticks">
          <li><span>A mismatched account is refused.</span></li>
          <li><span>Credentials never go into records or briefs.</span></li>
        </ul>
        <a class="p-more" href={DOCS.identityRouting}>Route identities per org <span aria-hidden="true">→</span></a>
      </div>
      <div class="frame reveal">
        <div class="frame-in">
          <div class="f-bar"><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="ttl">devtwin · identity</span><span class="right"><span class="pill" id="acct-pill">resolved</span></span></div>
          <div class="acct" data-scope="work" id="acct">
            <div class="scope-switch" role="group" aria-label="Active scope">
              <button type="button" aria-pressed="true" data-scope="work"><i aria-hidden="true"></i>work</button>
              <button type="button" aria-pressed="false" data-scope="client" class="gx"><i aria-hidden="true"></i>client</button>
            </div>
            <p class="cwd swap" id="acct-cwd">cwd <b>~/work/billing-service</b> → scope <b>work</b></p>
            <div class="ids swap" id="acct-ids" aria-live="polite">
              <div class="idrow">
                <span class="ic" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 16 16"><path fill="#edf0f7" d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.72 1.22 1.88.87 2.33.66.07-.52.28-.87.5-1.07-1.78-.2-3.65-.89-3.65-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg></span>
                <span class="who" data-gh>@sam-work<small>GitHub · work</small></span>
                <span class="pill ok">active</span>
              </div>
              <div class="idrow">
                <span class="ic" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#edf0f7" stroke-width="2" stroke-linecap="round"><path d="M9 3v8M15 13v8M3 15h8M13 9h8"/><path d="M9 3a2 2 0 1 1 2 2H9M15 21a2 2 0 1 1-2-2h2M3 15a2 2 0 1 1 2-2v2M21 9a2 2 0 1 1-2 2V9"/></svg></span>
                <span class="who" data-sl>Sam R.<small>Slack · work.slack.com</small></span>
                <span class="pill ok">active</span>
              </div>
              <div class="idrow">
                <span class="ic" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#edf0f7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/></svg></span>
                <span class="who" data-ln>sam-work<small>Linear · work</small></span>
                <span class="pill ok">active</span>
              </div>
              <div class="idrow">
                <span class="ic" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#edf0f7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 18h10a4 4 0 0 0 .5-7.97A6 6 0 0 0 6 9.5 4.25 4.25 0 0 0 7 18Z"/></svg></span>
                <span class="who" data-cl>work-prod<small>AWS · deploy role</small></span>
                <span class="pill ok">active</span>
              </div>
            </div>
            <div class="refuse" id="acct-refuse"><b>✕ refused</b> push to <span id="r-repo">work/billing-service</span> as <span id="r-who">@sam-client</span><br><span class="muted">scope work is bound to @sam-work</span></div>
          </div>
        </div>
      </div>
    </article>

    <!-- Pillar 5 -->
    <article class="pillar" id="harness" aria-labelledby="p5">
      <div class="p-copy reveal">
        <div class="p-num"><span>05</span> Your harness</div>
        <h3 id="p5">Make your agents work your way.</h3>
        <p>Write down your taste once in a small private profile, and turn the skill templates into skills that follow it.</p>
        <ul class="ticks">
          <li><span>A weekly radar for the tools you build with.</span></li>
          <li><span>Slack update drafts in your voice.</span></li>
          <li><span>Your writing rules, applied by every agent.</span></li>
        </ul>
        <a class="p-more" href={DOCS.personalHarness}>Build your personal harness <span aria-hidden="true">→</span></a>
      </div>
      <div class="frame reveal">
        <div class="frame-in">
          <div class="f-bar"><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="ttl">devtwin skill template-seed</span><span class="right"><span class="pill">profile: sam</span></span></div>
          <div class="gallery">
            <div class="tpl on">
              <span class="tpl-ic" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ff8a3d" stroke-width="2" stroke-linecap="round"><path d="M4 12a8 8 0 0 1 16 0"/><path d="M8 12a4 4 0 0 1 8 0"/><circle cx="12" cy="12" r="1.5" fill="#ff8a3d"/></svg></span>
              <h4>Stack-update watch</h4>
              <p>Announcements filtered by the dependencies in your projects.</p>
              <code>--template stack-watch</code>
            </div>
            <div class="tpl">
              <span class="tpl-ic" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#a6b0c4" stroke-width="2" stroke-linecap="round"><path d="M4 5h16v11H9l-5 4z"/></svg></span>
              <h4>Slack update draft</h4>
              <p>A weekly update from records and handoffs, in your tone.</p>
              <code>--template slack-update</code>
            </div>
            <div class="tpl">
              <span class="tpl-ic" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#a6b0c4" stroke-width="2" stroke-linecap="round"><path d="M4 20h4L19 9l-4-4L4 16z"/></svg></span>
              <h4>Writing style</h4>
              <p>Your voice for docs, PRs and messages.</p>
              <code>--template writing</code>
            </div>
            <div class="tpl add">
              <span class="tpl-ic" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#a6b0c4" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></span>
              <h4>Your next skill</h4>
              <p>Templates are just files. Write one.</p>
            </div>
          </div>
          <div class="digest">
            <div class="cmd"><span class="p">$</span> devtwin stack digest --scope work</div>
            <div><span class="acc">●</span> New Claude model release <span class="muted">· project work.billing</span></div>
            <div><span class="acc">●</span> Auth provider SDK major release <span class="muted">· your stack</span></div>
            <div class="muted">previously reported, not repeated: 31</div>
          </div>
        </div>
      </div>
    </article>

    <!-- Pillar 6 -->
    <article class="pillar flip" id="disk" aria-labelledby="p6">
      <div class="p-copy reveal">
        <div class="p-num"><span>06</span> Local-first</div>
        <h3 id="p6">Keep all of it on your own machine.</h3>
        <p>Records and profiles stay on your machine in private folders. Nothing leaves without your consent.</p>
        <ul class="ticks">
          <li><span>No account and no server, only plain files.</span></li>
          <li><span>An encrypted backup every day, kept for 14 days.</span></li>
          <li><span><code>devtwin doctor</code> checks it all.</span></li>
        </ul>
        <a class="p-more" href={DOCS.whereDataLives}>Where your data lives <span aria-hidden="true">→</span></a>
      </div>
      <div class="frame reveal">
        <div class="frame-in">
          <div class="disk">
            <div>
              <h4><span class="pill">public</span> the kit</h4>
<div class="tree" set:html={lines(kitTree)} />
            </div>
            <div>
              <h4><span class="pill acc">private</span> your data</h4>
<div class="tree" set:html={lines(dataTree)} />
            </div>
          </div>
          <div class="disk-foot">
            <span class="cmd"><span class="acc">$</span> devtwin doctor</span>
            <span class="pill ok">roots private</span>
            <span class="pill ok">bound repos unchanged</span>
          </div>
        </div>
      </div>
    </article>
  </div>
</section>
