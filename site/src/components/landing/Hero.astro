---
import { GITHUB_URL, DOCS, INSTALL_CMD } from '../../site';
import HeroGrid from './HeroGrid.astro';
import CrtGlass from './CrtGlass.astro';
import ContextGraph from './ContextGraph.astro';
---
<section class="hero" id="top" aria-labelledby="hero-title">
  <HeroGrid />
  <div class="wrap">
    <div class="hero-copy">
      <a class="eyebrow" href="#open-source"><b>Open source</b><span>Your developer twin<span class="eyebrow-x">, for every coding agent</span></span></a>
      <h1 id="hero-title" data-decode data-decode-delay="360">Clone the <em>developer.</em></h1>
      <p class="lede">Your agents can read any codebase. devtwin gives them your taste and carries it into every project you work on.</p>
      <div class="hero-actions">
        <div class="install" role="group" aria-label="Install command">
          <span class="install-line"><span class="prompt" aria-hidden="true">$ </span><span class="install-text">{INSTALL_CMD}</span></span>
          <button class="copy" type="button" data-copy={INSTALL_CMD}>Copy</button>
        </div>
        <div class="action-btns">
          <a class="btn btn-primary" href={DOCS.installation}>Get started <span aria-hidden="true">→</span></a>
          <a class="btn btn-ghost" href={GITHUB_URL}>View on GitHub <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="works">
        <span>Works with</span>
        <span class="wm"><i aria-hidden="true"></i>Claude Code</span>
        <span class="wm cx"><i aria-hidden="true"></i>Codex</span>
      </div>
    </div>

    <div class="stage stage-wide reveal">
      <div class="stage-inner"><ContextGraph /></div>
    </div>
  </div>
  <CrtGlass />
</section>
