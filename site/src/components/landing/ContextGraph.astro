---
// The hero context graph (issue #11), from the approved design in the Codex/Astra session. Saved preferences, project
// records and lessons feed one session brief; Claude Code, Codex and Gemini CLI get the same project context; a new lesson
// loops back.
// Every class and id is prefixed cg- so the page's global styles and scripts never touch it.
---
<svg style="position:absolute;width:0;height:0;overflow:hidden" aria-hidden="true"><defs>
<symbol id="cg-i-mark" viewBox="0 0 28 28"><path d="M4 5h8v18H4zM16 5h8v18h-8z" fill="none" stroke="currentColor" stroke-width="2"/><path d="M8 10h12M8 18h12" stroke="currentColor" stroke-width="2"/></symbol>
<symbol id="cg-i-file" viewBox="0 0 24 24"><path d="M6 3h8l4 4v14H6zM14 3v5h4M9 12h6M9 16h6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></symbol>
<symbol id="cg-i-user" viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.5" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M5 21v-2a7 7 0 0 1 14 0v2" fill="none" stroke="currentColor" stroke-width="1.3"/></symbol>
<symbol id="cg-i-lock" viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="11" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 10V6a4 4 0 0 1 8 0v4" fill="none" stroke="currentColor" stroke-width="1.5"/></symbol>
<symbol id="cg-i-loop" viewBox="0 0 24 24"><path d="M4 9a8 8 0 1 1 0 7M4 3v6h6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
<symbol id="cg-i-skill" viewBox="0 0 24 24"><path d="m8 4-5 8 5 8m8-16 5 8-5 8M14 4l-4 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></symbol>
<symbol id="cg-i-team" viewBox="0 0 24 24"><circle cx="12" cy="5" r="3" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="5" cy="18" r="3" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="19" cy="18" r="3" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="m10.5 8-4 7m7-7 4 7M8 18h8" stroke="currentColor" stroke-width="1.5"/></symbol>
</defs></svg>
<div class="cg-stage" role="region" aria-label="Animated example of how devtwin carries project context between sessions">
<header class="cg-topbar"><svg class="cg-brand-mark" aria-hidden="true"><use href="#cg-i-mark"/></svg><span class="cg-brand">devtwin</span><span class="cg-topline">Context that carries forward.</span><div class="cg-controls"><span class="cg-live">context flowing</span><button class="cg-replay" id="cg-motion-toggle" aria-label="Pause automatic project changes and motion">Ⅱ &nbsp; Pause motion</button></div></header>
<div class="cg-graph" id="cg-graph">
<svg class="cg-wires" id="cg-wires" aria-hidden="true"></svg>
<div class="cg-lane cg-lane-left"><span>1</span><b>What you know</b></div><div class="cg-lane cg-lane-center"><span>2</span><b>Ready for this project</b></div><div class="cg-lane cg-lane-right"><span>3</span><b>In your agent</b></div>
<section class="cg-sources" aria-label="Your saved context">
<article class="cg-record" id="cg-preference"><div class="cg-record-top"><strong>Preference</strong><span class="cg-scope">personal</span></div><p>Write the failing test first. One change per PR.</p></article>
<article class="cg-record" id="cg-decision"><div class="cg-record-top"><strong>Decision</strong><span class="cg-scope cg-project-name">billing-service</span></div><p data-cg="decision">Cursor pagination, since offsets skipped rows.</p></article>
<article class="cg-record" id="cg-constraint"><div class="cg-record-top"><strong>Constraint</strong><span class="cg-scope">project</span></div><p data-cg="constraint">Never charge twice: retries reuse the key.</p></article>
<article class="cg-record" id="cg-handoff"><div class="cg-record-top"><strong>Handoff</strong><span class="cg-scope">last session</span></div><p data-cg="handoff">Backoff jitter done. 429 handling is next.</p></article>
<article class="cg-record cg-lesson-source" id="cg-saved-lesson"><div class="cg-record-top"><strong>Lesson</strong><span class="cg-fresh">carried forward</span></div><p data-cg="lesson">Check status first: a 4xx retry hid a bad key.</p></article>
<div class="cg-record-foot"><svg aria-hidden="true"><use href="#cg-i-lock"/></svg>Private files · yours to keep</div>
</section>
<div class="cg-identity" id="cg-identity"><span class="cg-avatar"><svg aria-hidden="true"><use href="#cg-i-user"/></svg></span><div class="cg-identity-text"><small>You, working on</small><strong class="cg-project-select" id="cg-project">billing-service</strong></div></div>
<section class="cg-brief" id="cg-brief" aria-label="Bounded project brief"><div class="cg-brief-heading"><svg aria-hidden="true"><use href="#cg-i-file"/></svg><h3>Session brief</h3><span class="cg-brief-count">project context</span></div><div class="cg-brief-content"><p class="cg-brief-intro">Your preferences + project context</p><ul class="cg-brief-items"><li data-cg="brief1">Write the failing test first</li><li data-cg="brief2">Use cursor pagination</li><li data-cg="brief3">Retries reuse the idempotency key</li><li data-cg="brief4">Next: 429 handling in the retry job</li></ul></div><div class="cg-brief-meta"><svg aria-hidden="true"><use href="#cg-i-file"/></svg>Bounded brief · linked to sources</div></section>
<p class="cg-brief-caption">Project context at session start.<br><strong>Lessons when files or commands match.</strong></p><span class="cg-flow-label">same<br>context</span>
<section class="cg-agents" aria-label="Supported coding agents"><article class="cg-agent" id="cg-claude"><div class="cg-agent-heading"><span class="cg-agent-symbol" aria-hidden="true">✳</span>Claude Code</div><div class="cg-agent-body"><p class="cg-agent-prompt" data-cg="prompt">pick up the retry fix</p><div class="cg-loaded"><span aria-hidden="true">✓</span> Project brief loaded</div><p class="cg-agent-output">Continuing from <span>your handoff.</span><i class="cg-cursor" aria-hidden="true"></i></p></div></article><article class="cg-agent" id="cg-codex"><div class="cg-agent-heading"><span class="cg-agent-symbol cg-codex-symbol" aria-hidden="true">⌘</span>Codex</div><div class="cg-agent-body"><p class="cg-agent-prompt" data-cg="review">review the retry fix</p><div class="cg-loaded"><span aria-hidden="true">✓</span> Same context, same rules</div><p class="cg-agent-output" data-cg="agentResult">Checked: the retry reuses the key.</p></div></article><article class="cg-agent" id="cg-gemini"><div class="cg-agent-heading"><span class="cg-agent-symbol cg-gemini-symbol" aria-hidden="true">✦</span>Gemini CLI</div><div class="cg-agent-body"><p class="cg-agent-prompt" data-cg="tests">add tests for the retry fix</p><div class="cg-loaded"><span aria-hidden="true">✓</span> Same brief, same handoff</div><p class="cg-agent-output" data-cg="testResult">Added a 429 retry test.</p></div></article></section>
<span class="cg-skill-path-label">shaped by your preferences</span>
<section class="cg-skill-node" id="cg-skills" aria-label="Templates become private skills"><h2 class="cg-branch-heading"><svg aria-hidden="true"><use href="#cg-i-skill"/></svg>Make the workflow yours</h2><div class="cg-skill-route"><span class="cg-template-file">writing</span><span class="cg-arrow" aria-hidden="true">→</span><span class="cg-private-skill">your private skill</span></div><p class="cg-branch-note">Writing · stack watch · team update drafts</p></section>
<span class="cg-loop-label">↶ &nbsp; the next session starts here</span>
<section class="cg-team-node" id="cg-team" aria-label="Choose which lessons to share with a team"><h2 class="cg-branch-heading"><svg aria-hidden="true"><use href="#cg-i-team"/></svg>Your team learns with you</h2><p class="cg-team-note">Useful lessons → your org's hub or knowledge server</p><div class="cg-team-chips"><span>with your consent</span><span>held before sharing</span></div></section>
<span class="cg-team-label">share by<br>choice</span><span class="cg-learn-label">record as you work</span>
<section class="cg-learning" id="cg-learning" aria-label="Example of an automatically observed project lesson"><div class="cg-learning-heading"><svg aria-hidden="true"><use href="#cg-i-loop"/></svg>A new project lesson</div><div class="cg-lesson"><p data-cg="lesson">Check status first: a 4xx retry hid a bad key.</p><span class="cg-observed" id="cg-observed">● observed by your agent</span></div><div class="cg-activity"><span id="cg-activity-label">Recorded in activity</span><button class="cg-undo" id="cg-undo" aria-label="Undo the lesson in this visual example">Undo</button></div></section>
</div>
<footer class="cg-bottom"><span id="cg-description" aria-live="polite"><strong>Your preferences travel.</strong> Project knowledge stays with its project.</span><span class="cg-hint">Your context follows your project.</span></footer>
</div>

<script>
// The hero context graph (issue #11): wires measured from the real cards, an automatic project rotation every 9 s, a
// Pause/Resume control and a demo-only Undo. Reduced motion follows the system setting and the page's motion gate.
const stage = document.querySelector<HTMLElement>('.cg-stage');
if (stage) {
	const graph = stage.querySelector<HTMLElement>('#cg-graph')!;
	const svg = stage.querySelector<SVGSVGElement>('#cg-wires')!;
	const ns = 'http://www.w3.org/2000/svg';
	const $ = <T extends Element = HTMLElement>(id: string) => stage.querySelector<T>('#cg-' + id)!;
	// The narrow layout follows the card's own width, as its container queries do.
	const narrow = () => graph.clientWidth <= 860;
	const make = (name: string, attrs: Record<string, string | number>) => {
		const el = document.createElementNS(ns, name);
		for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, String(v));
		return el;
	};
	type Pt = { x: number; y: number };
	const point = (id: string, side: string, f = 0.5): Pt => {
		const a = $(id).getBoundingClientRect(), b = graph.getBoundingClientRect();
		return { x: a.left - b.left + (side === 'right' ? a.width : side === 'left' ? 0 : a.width * f), y: a.top - b.top + (side === 'bottom' ? a.height : side === 'top' ? 0 : a.height * f) };
	};
	const curve = (a: Pt, b: Pt, axis = 'x') => {
		if (axis === 'y') { const d = Math.max(22, Math.abs(b.y - a.y) * 0.45); return `M${a.x},${a.y} C${a.x},${a.y + d} ${b.x},${b.y - d} ${b.x},${b.y}`; }
		const d = Math.max(28, Math.abs(b.x - a.x) * 0.48);
		return `M${a.x},${a.y} C${a.x + d},${a.y} ${b.x - d},${b.y} ${b.x},${b.y}`;
	};
	function draw() {
		svg.replaceChildren();
		svg.setAttribute('viewBox', `0 0 ${graph.clientWidth} ${graph.clientHeight}`);
		let n = 0;
		const wire = (a: Pt, b: Pt, kind = '', custom?: string) => {
			const d = custom || curve(a, b), k = kind ? ' cg-' + kind : '';
			svg.append(make('path', { d, class: 'cg-wire' + k }));
			svg.append(make('path', { d, class: 'cg-pulse' + k, pathLength: 200, style: `animation-delay:${-n++ * 1.13}s` }));
			for (const c of [a, b]) svg.append(make('circle', { cx: c.x, cy: c.y, r: 3, class: 'cg-port ' + (kind === 'return' ? 'cg-cool cg-return-port' : kind === 'team' ? 'cg-cool' : 'cg-hot') }));
		};
		if (!narrow()) {
			['preference', 'decision', 'constraint', 'handoff'].forEach((id, i) => wire(point(id, 'right'), point('brief', 'left', 0.29 + i * 0.16)));
			wire(point('saved-lesson', 'right'), point('brief', 'left', 0.94), 'return');
			wire(point('identity', 'bottom'), point('brief', 'top'), '', curve(point('identity', 'bottom'), point('brief', 'top'), 'y'));
			['claude', 'codex', 'gemini'].forEach((id, i) => wire(point('brief', 'right', 0.3 + i * 0.25), point(id, 'left', 0.5)));
			const c = point('gemini', 'bottom', 0.64), l = point('learning', 'top', 0.64);
			wire(c, l, 'return', curve(c, l, 'y'));
			const cl = point('claude', 'right', 0.7), lr = point('learning', 'right', 0.34), edge = graph.clientWidth - 17;
			wire(cl, lr, 'return', `M${cl.x},${cl.y} C${edge},${cl.y} ${edge},${lr.y} ${lr.x},${lr.y}`);
			const learn = point('learning', 'left', 0.23), saved = point('saved-lesson', 'bottom', 0.75), y = point('learning', 'top').y - 32;
			wire(learn, saved, 'return', `M${learn.x},${learn.y} C${learn.x - 28},${learn.y} ${learn.x - 28},${y} ${learn.x - 70},${y} L${saved.x + 30},${y} Q${saved.x},${y} ${saved.x},${saved.y}`);
			const a = point('learning', 'left', 0.68), b = point('team', 'right', 0.45);
			wire(a, b, 'team', `M${a.x},${a.y} C${a.x - 35},${a.y} ${b.x + 35},${b.y} ${b.x},${b.y}`);
			const pref = point('preference', 'left', 0.5), sk = point('skills', 'top', 0.16), x = pref.x - 23;
			wire(pref, sk, 'skill', `M${pref.x},${pref.y} C${x},${pref.y} ${x},${pref.y + 20} ${x},${pref.y + 40} L${x},${sk.y - 24} Q${x},${sk.y - 8} ${sk.x - 14},${sk.y - 8} Q${sk.x},${sk.y - 8} ${sk.x},${sk.y}`);
		} else {
			const brief = point('brief', 'left', 0.25);
			['preference', 'decision', 'constraint', 'handoff', 'saved-lesson'].forEach((id, i) => {
				const a = point(id, 'left'), x = 18 + i * 3;
				wire(a, brief, id === 'saved-lesson' ? 'return' : '', `M${a.x},${a.y} C${x},${a.y} ${x},${a.y + 20} ${x},${a.y + 40} L${x},${brief.y - 30} Q${x},${brief.y} ${brief.x},${brief.y}`);
			});
			wire(point('identity', 'bottom', 0.5), point('brief', 'top', 0.5), '', curve(point('identity', 'bottom', 0.5), point('brief', 'top', 0.5), 'y'));
			for (const id of ['claude', 'codex', 'gemini']) {
				const a = point('brief', 'right', 0.6), b = point(id, 'right', 0.5), x = graph.clientWidth - 12;
				wire(a, b, '', `M${a.x},${a.y} Q${x},${a.y} ${x},${a.y + 25} L${x},${b.y - 25} Q${x},${b.y} ${b.x},${b.y}`);
			}
			wire(point('gemini', 'bottom', 0.8), point('learning', 'top', 0.8), 'return', curve(point('gemini', 'bottom', 0.8), point('learning', 'top', 0.8), 'y'));
			const a = point('learning', 'left', 0.5), b = point('saved-lesson', 'left', 0.5), x = 10;
			wire(a, b, 'return', `M${a.x},${a.y} Q${x},${a.y} ${x},${a.y - 25} L${x},${b.y + 25} Q${x},${b.y} ${b.x},${b.y}`);
			wire(point('learning', 'bottom', 0.8), point('team', 'top', 0.8), 'team', curve(point('learning', 'bottom', 0.8), point('team', 'top', 0.8), 'y'));
			const p = point('preference', 'right', 0.3), s = point('skills', 'right', 0.5), right = graph.clientWidth - 5;
			wire(p, s, 'skill', `M${p.x},${p.y} Q${right},${p.y} ${right},${p.y + 25} L${right},${s.y - 25} Q${right},${s.y} ${s.x},${s.y}`);
		}
	}
	let pending = 0;
	const schedule = () => { cancelAnimationFrame(pending); pending = requestAnimationFrame(draw); };
	const observer = new ResizeObserver(schedule);
	observer.observe(graph);
	stage.querySelectorAll('.cg-record,.cg-brief,.cg-identity,.cg-agents,.cg-learning,.cg-team-node,.cg-skill-node').forEach((el) => observer.observe(el));
	window.addEventListener('resize', schedule);
	draw();

	const data: Record<string, Record<string, string>> = {
		billing: { name: 'billing-service', decision: 'Cursor pagination, since offsets skipped rows.', constraint: 'Never charge twice: retries reuse the key.', handoff: 'Backoff jitter done. 429 handling is next.', lesson: 'Check status first: a 4xx retry hid a bad key.', brief1: 'Write the failing test first', brief2: 'Use cursor pagination', brief3: 'Retries reuse the idempotency key', brief4: 'Next: 429 handling in the retry job', prompt: 'pick up the retry fix', review: 'review the retry fix', agentResult: 'Checked: the retry reuses the key.', tests: 'add tests for the retry fix', testResult: 'Added a 429 retry test.' },
		store: { name: 'sample-store', decision: 'All reads go through the query layer.', constraint: 'Money is integer cents. Floats broke refunds.', handoff: 'CSV writer done. Column names and tests next.', lesson: 'Name every column. SELECT * broke the export.', brief1: 'Write the failing test first', brief2: 'Read through the query layer', brief3: 'Money stays in integer cents', brief4: 'Next: name the export columns', prompt: 'finish the order export', review: 'review the order export', agentResult: 'Checked: the export keeps integer cents.', tests: 'test the order export', testResult: 'Added a refund test.' },
	};
	let replayTimer = 0;
	const replay = () => { graph.classList.remove('cg-replaying'); void graph.offsetWidth; graph.classList.add('cg-replaying'); clearTimeout(replayTimer); replayTimer = window.setTimeout(() => graph.classList.remove('cg-replaying'), 2400); };
	const media = matchMedia('(prefers-reduced-motion: reduce)'), root = document.documentElement;
	// The page's motion gate (html.m-on / html.m-off) counts as well as the system setting.
	const reduced = () => media.matches || !root.classList.contains('m-on');
	const toggle = $<HTMLButtonElement>('motion-toggle'), live = stage.querySelector<HTMLElement>('.cg-live')!;
	const undo = $<HTMLButtonElement>('undo'), observed = $('observed'), activity = $('activity-label'), description = $('description');
	let current = 'billing', paused = reduced(), cycleTimer = 0, transitionTimer = 0;
	function resetUndo() {
		graph.classList.remove('cg-undone');
		undo.textContent = 'Undo';
		undo.setAttribute('aria-label', 'Undo the lesson in this visual example');
		observed.textContent = '● observed by your agent';
		activity.textContent = 'Recorded in activity';
	}
	function switchProject() {
		clearTimeout(transitionTimer);
		if (!reduced()) graph.classList.add('cg-switching');
		transitionTimer = window.setTimeout(() => {
			current = current === 'billing' ? 'store' : 'billing';
			const d = data[current];
			$('project').textContent = d.name;
			stage.querySelectorAll<HTMLElement>('[data-cg]').forEach((el) => { el.textContent = d[el.dataset.cg!]; });
			stage.querySelectorAll('.cg-project-name').forEach((el) => { el.textContent = d.name; });
			resetUndo();
			description.textContent = `${d.name} context loaded. Your personal preference stays the same.`;
			graph.classList.remove('cg-switching');
			schedule();
			if (!reduced()) replay();
		}, reduced() ? 0 : 220);
	}
	function armCycle() {
		clearTimeout(cycleTimer);
		if (!paused && !reduced() && !document.hidden) cycleTimer = window.setTimeout(() => { switchProject(); armCycle(); }, 9000);
	}
	function updateMotion() {
		stage.classList.toggle('cg-paused', paused);
		const r = reduced();
		toggle.textContent = r ? 'Next example' : paused ? '▶  Resume motion' : 'Ⅱ  Pause motion';
		toggle.setAttribute('aria-label', r ? 'Show the next project example' : paused ? 'Resume automatic project changes and motion' : 'Pause automatic project changes and motion');
		live.textContent = paused ? 'context ready' : 'context flowing';
		armCycle();
	}
	toggle.addEventListener('click', () => { if (reduced()) { switchProject(); return; } paused = !paused; updateMotion(); });
	// React only when reduced motion flips; other class changes on <html> must not undo a manual Pause.
	let wasReduced = reduced();
	const onGate = () => { const r = reduced(); if (r === wasReduced) return; wasReduced = r; paused = r; updateMotion(); };
	media.addEventListener('change', onGate);
	new MutationObserver(onGate).observe(root, { attributes: true, attributeFilter: ['class'] });
	document.addEventListener('visibilitychange', armCycle);
	updateMotion();
	undo.addEventListener('click', () => {
		if (graph.classList.contains('cg-undone')) {
			resetUndo();
			description.textContent = 'Example lesson restored. It is available for future matching sessions.';
			replay();
			return;
		}
		graph.classList.add('cg-undone');
		undo.textContent = 'Restore';
		undo.setAttribute('aria-label', 'Restore the lesson in this visual example');
		observed.textContent = 'Undone in this example';
		activity.textContent = 'Undo recorded in activity';
		description.textContent = 'Lesson undone. Your other project records stay available.';
	});
}
</script>

<style is:global>
.cg-stage{--bg:#080d18;--ink:#eef2fa;--muted:#a4b1c8;--orange:#ff9958;--neon:#3dbbff;--blue:#b6c7ff;--mono:ui-monospace,SFMono-Regular,Consolas,monospace;--sans:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
