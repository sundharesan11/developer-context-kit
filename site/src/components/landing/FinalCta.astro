---
import { GITHUB_URL, DOCS } from '../../site';
import DitherBand from './DitherBand.astro';
---
<section class="final" aria-labelledby="final-title">
  <DitherBand />
  <div class="wrap reveal">
    <h2 id="final-title" data-decode>Your next session starts where <span style="color:var(--accent)">you</span> left off.</h2>
    <p>Give every agent your context, your accounts and your habits — and keep all of it on your disk.</p>
    <div class="hero-actions">
      <!-- TODO: confirm install command at release -->
      <div class="install" role="group" aria-label="Install command">
        <span><span class="prompt" aria-hidden="true">$ </span>npx devctx init</span>
        <button class="copy" type="button" data-copy="npx devctx init">Copy</button>
      </div>
      <!-- TODO: confirm the GitHub org/user (sundharesan11) at release -->
      <a class="btn btn-primary" href={GITHUB_URL}>Star on GitHub</a>
      <a class="btn btn-ghost" href={DOCS.home}>Read the docs <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>
