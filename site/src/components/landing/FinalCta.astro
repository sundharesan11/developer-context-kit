---
import { GITHUB_URL, DOCS, INSTALL_CMD } from '../../site';
import DitherBand from './DitherBand.astro';
---
<section class="final" aria-labelledby="final-title">
  <DitherBand />
  <div class="wrap reveal">
    <h2 id="final-title" data-decode>Now clone <span style="color:var(--accent)">yourself</span>.</h2>
    <p class="final-lead">Start with a template. End with an assistant that works like you.</p>
    <p>Your taste and your team's lessons, in every agent session. Your data stays on your disk.</p>
    <div class="hero-actions">
      <div class="install" role="group" aria-label="Install command">
        <span class="install-line"><span class="prompt" aria-hidden="true">$ </span>{INSTALL_CMD}</span>
        <button class="copy" type="button" data-copy={INSTALL_CMD}>Copy</button>
      </div>
      <div class="action-btns">
        <a class="btn btn-primary" href={GITHUB_URL}>Star on GitHub</a>
        <a class="btn btn-ghost" href={DOCS.home}>Read the docs <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</section>
