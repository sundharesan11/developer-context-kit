    },
    "pilotRoot": {
      "type": "string"
    },
    "configRoot": {
      "type": "string"
    },
    "dataRoot": {
      "type": "string"
    },
    "stateRoot": {
      "type": "string"
    },
    "inputsRoot": {
      "type": "string"
    },
    "agentHomes": {
      "type": "array"
    },
    "repos": {
      "type": "array"
    },
    "forbidden": {
      "type": "array"
    }
  }
}
