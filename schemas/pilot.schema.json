{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "devtwin pilot v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "pilotRoot",
    "configRoot",
    "dataRoot",
    "stateRoot",
    "inputsRoot",
    "agentHomes",
    "repos",
    "forbidden"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "pilotRoot": {
      "type": "string"
    },
    "configRoot": {
      "type": "string"
    },
    "dataRoot": {
      "type": "string"
    },
    "stateRoot": {
      "type": "string"
    },
    "inputsRoot": {
      "type": "string"
    },
    "agentHomes": {
      "type": "array"
    },
    "repos": {
      "type": "array"
    },
    "forbidden": {
      "type": "array"
    },
    "live": {
      "type": "object",
      "required": [
        "configId",
        "home",
        "skillDirs",
        "kitRoot",
        "kitCommit"
      ],
      "additionalProperties": false,
      "properties": {
        "configId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{7,63}$"
        },
        "home": {
          "type": "string"
        },
        "skillDirs": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "claude": {
              "type": "string"
            },
            "codex": {
              "type": "string"
            }
          }
        },
        "kitRoot": {
          "type": "string"
        },
        "kitCommit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        }
      }
    },
    "writeClasses": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hubRoot": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "instructionTargets": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "hookTargets": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "launchAgents": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "/devtwin\\.[a-z0-9][a-z0-9.-]{0,95}\\.plist$"
          }
        }
      }
    }
  }
}
